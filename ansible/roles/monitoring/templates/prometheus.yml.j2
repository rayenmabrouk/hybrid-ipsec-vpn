# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: gw-onprem
    static_configs:
      - targets: ["{{ monitoring_exporter_listen }}"]
        labels:
          site: onprem
