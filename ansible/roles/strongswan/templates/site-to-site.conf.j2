# {{ ansible_managed }}
# {{ inventory_hostname }} - {{ ipsec_role }} ({{ ipsec_local_ts }} <-> {{ ipsec_remote_ts }})
connections {
  site-to-site {
    version = 2
    local_addrs  = {{ ipsec_local_addrs }}
    remote_addrs = {{ ipsec_remote_addrs }}
    # Hybrid post-quantum key exchange: ECDH P-384 + ML-KEM-768 (RFC 9370)
    proposals = {{ ipsec_ike_proposal }}
    dpd_delay = {{ ipsec_dpd_delay }}
{% if ipsec_role == 'initiator' %}
    keyingtries = 0   # retry forever: recover by itself after a long outage of the peer
{% endif %}
    local {
      auth  = pubkey
      certs = {{ inventory_hostname }}.crt
      id    = {{ inventory_hostname }}.{{ pki_domain }}
    }
    remote {
      auth    = pubkey
      id      = {{ ipsec_peer }}.{{ pki_domain }}
      cacerts = lab-ca.crt
    }
    children {
      lan {
        local_ts  = {{ ipsec_local_ts }}
        remote_ts = {{ ipsec_remote_ts }}
        # PFS on every rekey, also hybrid post-quantum
        esp_proposals = {{ ipsec_esp_proposal }}
{% if ipsec_role == 'initiator' %}
        start_action = start
        dpd_action   = restart
        close_action = start
{% else %}
        dpd_action = clear
{% endif %}
      }
    }
  }
}
